{
  "name": "indbase-theme",
  "private": true,
  "scripts": {
    "build": "sass --no-source-map --style=expanded scss:css",
    "watch": "sass --watch --poll --no-source-map --style=expanded scss:css",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sass": "^1.93.0"
  }
}
